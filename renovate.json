{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "pin"
    }
  ],
  "commitMessagePrefix": "⬆️",
  "commitMessageAction": "upgrade"
}
